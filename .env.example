# -----------------------------------------------------------------------------
# Secure Delegated Access Platform (SDAP)
# Local Development Environment Configuration (.env.example)
#
# IMPORTANT: Docker is no longer required for day-to-day development.
# Copy this file to `.env` and populate it with your cloud credentials.
# -----------------------------------------------------------------------------

# --- Server Configuration ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL via Neon) ---
# Use a persistent cloud database (e.g. Neon Free Tier) for local development
# Format: postgresql://<user>:<password>@<neon-hostname>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/withus-dev?sslmode=require"



# --- Security & JWT ---
# Keys used by the JwtStrategy. In production, these should be loaded from Vault/Secrets Manager
# For local dev, they are read from `keys/public.pem` and `keys/private.pem` if not provided here.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Vault Cryptography ---
# 32-byte Base64 string for the Master Encryption Key (MEK) used in the Vault.
# Generate locally via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# VAULT_ENCRYPTION_KEY="c3VwZXJzZWNyZXRrZXliYXNlNjRtdXN0YmUzMmJ5dGVz"
