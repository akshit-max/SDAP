# -----------------------------------------------------------------------------
# Secure Delegated Access Platform (SDAP)
# Local Development Environment Configuration
# -----------------------------------------------------------------------------

# --- Server Configuration ---
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ---
# Default matches docker-compose.yml postgres service
DATABASE_URL="postgresql://postgres:password@localhost:5432/sdap?schema=public"

# --- Redis (Caching & Rate Limiting) ---
# Default matches docker-compose.yml redis service
REDIS_URL="redis://localhost:6379"

# --- Security & JWT ---
# Keys used by the JwtStrategy. In production, these should be loaded from Vault/Secrets Manager
# For local dev, they are read from `keys/public.pem` and `keys/private.pem` if not provided here.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- pgAdmin (Optional Tools Profile) ---
# Used if running `docker compose --profile tools up -d`
PGADMIN_DEFAULT_EMAIL=admin@sdap.local
PGADMIN_DEFAULT_PASSWORD=admin
