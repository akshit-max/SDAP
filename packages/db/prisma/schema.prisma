generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum SecretType {
  PASSWORD
  API_KEY
  TOKEN
  SSH_KEY
  CERTIFICATE
  OAUTH
  COOKIE
  TEXT
  JSON
  OTHER
}

enum SecretStatus {
  ACTIVE
  DISABLED
  PENDING_ROTATION
  DELETED
}

enum KeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  fullName               String    @default("")
  passwordHash           String
  emailVerifiedAt        DateTime?
  emailVerificationToken String?
  isActive               Boolean   @default(true)
  // ─── Platform-level Super Admin flag ─────────────────────────────────────────
  // This is NOT an organization role. It exists at the platform level, completely
  // separate from MembershipRole (OWNER/ADMIN/MEMBER).
  // Default false — zero behavioral change for all existing users.
  isSuperAdmin           Boolean   @default(false)
  // ─── Login tracking — additive, nullable, zero behavioral change ─────────────
  lastLoginAt            DateTime? // Updated on every successful login
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  providerProfiles Json? // Stores provider-specific identities (e.g. { githubUsername: "octocat", vercelEmail: "user@example.com" })

  refreshTokens           RefreshToken[]
  organizationMemberships OrganizationMember[]
  grantedSessions         DelegatedSession[]   @relation("SessionGrantor")
  receivedSessions        DelegatedSession[]   @relation("SessionGrantee")
  approvalRequests        ApprovalRequest[]
  auditEvents             AuditEvent[]
  passwordResetTokens     PasswordResetToken[]
  presences               UserPresence[]
  platformAuditEvents     PlatformAuditEvent[] // Super Admin action log
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  isRevoked         Boolean   @default(false)
  expiresAt         DateTime
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?
  deviceInfo        Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([userId])
  @@index([familyId])
  // Composite: used by token validation (find active token for user)
  @@index([userId, isRevoked])
  // Composite: used by logout + password-reset (revoke all non-revoked tokens)
  @@index([userId, isRevoked, expiresAt])
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  settings  Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  members                OrganizationMember[]
  invitations            OrganizationInvitation[]
  vaults                 Vault[]
  delegatedSessions      DelegatedSession[]
  approvalRequests       ApprovalRequest[]
  auditEvents            AuditEvent[]
  integrationConnections IntegrationConnection[]
  apiKeys                ApiKey[]
  webhookSubscriptions   WebhookSubscription[]
  userPresences          UserPresence[]
  subscription           Subscription? // Billing: one per org, null = FREE plan
}

model OrganizationMember {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  joinedAt       DateTime       @default(now())
  removedAt      DateTime?
  invitedBy      String?
  lastActiveAt   DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([tokenHash])
}

model KeyMetadata {
  id        String    @id @default(uuid())
  version   Int       @unique
  algorithm String    @default("AES-256-GCM")
  status    KeyStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  secrets                Secret[]
  secretVersions         SecretVersion[]
  integrationConnections IntegrationConnection[]
}

model Vault {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  defaultTTL     Int? // Future: Default session TTL in seconds
  rotationPolicy Json? // Future: Auto-rotation configuration
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  secrets      Secret[]

  @@index([organizationId])
}

model Secret {
  id            String       @id @default(uuid())
  vaultId       String
  name          String
  description   String?
  type          SecretType   @default(OTHER)
  status        SecretStatus @default(ACTIVE)
  encryptedDek  String // DEK encrypted by MEK
  keyMetadataId String // References KeyMetadata.id

  lastRevealedAt DateTime?
  revealCount    Int       @default(0)
  lastRotatedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  vault       Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata     @relation(fields: [keyMetadataId], references: [id])
  versions    SecretVersion[]

  @@unique([vaultId, name])
  @@index([vaultId])
}

model SecretVersion {
  id            String  @id @default(uuid())
  secretId      String
  version       Int
  ciphertext    String
  iv            String
  authTag       String
  fingerprint   String // SHA-256 of plaintext
  algorithm     String  @default("AES-256-GCM")
  keyMetadataId String
  aadHash       String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  createdBy String?

  secret      Secret      @relation(fields: [secretId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata @relation(fields: [keyMetadataId], references: [id])

  @@unique([secretId, version])
  @@index([secretId])
}

enum SessionStatus {
  PENDING_GRANT // Integration-bound: DB row written, grantAccess() not yet confirmed
  ACTIVE
  REVOKE_FAILED // revokeAccess() failed; scheduler will retry
  REVOKED
  EXPIRED
}

enum SessionScope {
  VAULT
  SECRET
  INTEGRATION
}

enum SessionPermission {
  REVEAL // Grants password reveal access in the WITHUS web portal
  EXTENSION // Grants browser extension / autofill access only — no portal reveal
}

model DelegatedSession {
  id             String @id @default(uuid())
  organizationId String
  grantorId      String // User who created the session
  granteeId      String // Internal User who can use the session

  scope      SessionScope
  resourceId String // ID of the Vault or Secret based on scope
  permission SessionPermission @default(REVEAL)

  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  maxReveals   Int? // Optional limit on reveals
  revealCount  Int           @default(0)
  capabilities Json? // Array of strings representing module-level access (null = unrestricted)

  // ─── Integration binding ─────────────────────────────────────────────────
  // Populated when a native provider integration is used (e.g. Vercel, GitHub).
  // Gives the revocation worker all context it needs — no guessing.
  integrationProvider           String? // e.g. "VERCEL" | "GITHUB"
  integrationResourceType       String? // e.g. "TEAM" | "ORGANIZATION" | "REPOSITORY"
  integrationResourceExternalId String? // e.g. teamId, orgLogin, "owner/repo"
  integrationReferenceId        String? // Provider-issued ID returned by grantAccess (uid, username, etc.)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
  revokedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantor      User         @relation("SessionGrantor", fields: [grantorId], references: [id])
  grantee      User         @relation("SessionGrantee", fields: [granteeId], references: [id])

  @@index([organizationId])
  @@index([granteeId])
  @@index([status])
  @@index([resourceId])
  // Composite: used by expiry scheduler and session dashboard queries
  @@index([organizationId, status])
  // Composite: used by getIncomingSessions with status filter
  @@index([granteeId, status])
  // Composite: used by getOutgoingSessions
  @@index([grantorId, organizationId])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  DELEGATED_SESSION
}

model ApprovalRequest {
  id             String @id @default(uuid())
  organizationId String
  requesterId    String

  type           ApprovalType @default(DELEGATED_SESSION)
  requestPayload Json

  status ApprovalRequestStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?
  reason     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation(fields: [requesterId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model AuditEvent {
  id             String  @id @default(uuid())
  organizationId String
  actorId        String? // The user who performed the action

  action       String // e.g., "secret.revealed", "session.created"
  resourceType String? // e.g., "SECRET", "DELEGATED_SESSION", "APPROVAL_REQUEST"
  resourceId   String? // e.g., secretId, sessionId, approvalId

  eventVersion Int   @default(1)
  metadata     Json? // Serialized event data (e.g., reason for reveal)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@index([resourceType, resourceId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Release D: Integrations ────────────────────────────────────────────────

enum IntegrationProvider {
  VERCEL
  GITHUB
  GODADDY
  GMAIL
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

/// One row per (organization, provider) connection.
/// The PAT/token is encrypted with the org's MEK before storage.
model IntegrationConnection {
  id             String              @id @default(uuid())
  organizationId String
  provider       IntegrationProvider
  status         IntegrationStatus   @default(ACTIVE)

  /// Encrypted PAT — AES-256-GCM envelope, same scheme as secrets.
  encryptedToken String
  encryptedDek   String
  keyMetadataId  String

  /// Provider-specific metadata (team ID, org slug, account ID, etc.)
  providerMeta Json?

  /// Last time a health-check was performed against the provider API.
  lastCheckedAt DateTime?
  /// Human-readable error message from the last health-check failure.
  lastError     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyMetadata  KeyMetadata  @relation(fields: [keyMetadataId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ─── Release D: API Keys ─────────────────────────────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// API Keys issued to external integrations / CI pipelines.
/// The actual key is shown once on creation; only a SHA-256 hash is stored.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String // Human-readable label
  keyHash        String       @unique // SHA-256 of the raw key
  keyPrefix      String // First 8 chars for display (e.g. "sdap_abc1")
  status         ApiKeyStatus @default(ACTIVE)
  expiresAt      DateTime?
  lastUsedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  createdBy String?
  revokedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@index([organizationId, status])
}

model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  events         String[]
  secret         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Release E: User Presence Monitoring ─────────────────────────────────────
//
// Tracks the last time a user's extension sent a heartbeat for a specific
// platform. Completely separate from session lifecycle (ACTIVE/EXPIRED/REVOKED).
// One row per (organizationId, userId) — UPSERT on every heartbeat.
// Admin queries this to show 🟢 Active — MCA vs 🔴 Inactive.

model UserPresence {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  /// Which platform the extension was active on (e.g. "MCA", "GITHUB")
  platform       String
  /// The session that was active at last heartbeat — nullable (presence is session-independent)
  sessionId      String?
  /// Updated on every heartbeat. Stale = lastSeenAt < NOW() - 90s → INACTIVE
  lastSeenAt     DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One presence record per user per org per platform.
  // Multiple rows per user are expected (one per active platform).
  // UPSERT on every heartbeat prevents unbounded growth.
  @@unique([organizationId, userId, platform])
  @@index([organizationId, lastSeenAt])
}

// ─── Platform-Level Super Admin Audit ────────────────────────────────────────
//
// Records administrative actions performed by the WITHUS Super Admin.
// Completely separate from organization-scoped AuditEvent.
// organizationId is NOT a foreign key here — Super Admin actions are
// platform-level and do not belong to any single organization.

model PlatformAuditEvent {
  id      String @id @default(uuid())
  actorId String // Super Admin user ID

  action     String // e.g., "superadmin.viewed_org", "superadmin.viewed_users"
  targetType String? // e.g., "ORGANIZATION", "USER", "SESSION"
  targetId   String? // e.g., orgId, userId

  metadata  Json? // Additional context
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

// ─── Release F: Billing & Subscriptions ──────────────────────────────────────
//
// Architecture notes:
//   - Subscription: long-lived entity per org (one row, UPSERT pattern)
//   - Payment: immutable ledger — one row per transaction (registration, renewal, refund)
//   - hdfcMandateId lives on Subscription (stable across all executions)
//   - hdfcOrderId lives on Payment (unique per individual HDFC transaction)
//   - amounts stored as integer INR (e.g. 499 = ₹499)
//   - billing anchor: on renewal, newPeriodStart = previousPeriodEnd (not now)

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  FREE // No active paid plan; no mandate
  PENDING // Session initiated, awaiting customer payment/consent
  ACTIVE // Mandate active, recurring billing enabled
  PAST_DUE // Execution failed; inside grace period (scheduler will retry)
  CANCELLED // Owner requested cancel; service continues until currentPeriodEnd
  EXPIRED // Period ended or grace expired; reverted to FREE
}

enum PaymentStatus {
  PENDING // Execution initiated, not yet confirmed by HDFC
  SUCCESS // Confirmed CHARGED by HDFC Order Status API
  FAILED // Execution failed (insufficient funds, mandate issue, etc.)
  REFUNDED // Refund successfully processed
}

enum PaymentType {
  MANDATE_REGISTRATION // Initial payment that registers the mandate (via Session API)
  RECURRING_EXECUTION // Subsequent auto-debit via Mandate Execute API
  REFUND // Refund transaction
}

/// One subscription record per organization.
/// Created lazily on first billing action; orgs without a record are treated as FREE.
model Subscription {
  id             String             @id @default(uuid())
  organizationId String             @unique
  plan           PlanTier           @default(FREE)
  billingCycle   BillingCycle       @default(MONTHLY)
  status         SubscriptionStatus @default(FREE)
  currency       String             @default("INR")

  // ── HDFC identifiers ──────────────────────────────────────────────────────
  // hdfcMandateId: set once after mandate registration; stable across executions
  // hdfcCustomerId: our generated customer ID sent to HDFC (e.g. "cust-<orgId8>")
  hdfcMandateId  String?
  hdfcCustomerId String?

  // ── Amount snapshot at last billing calculation ───────────────────────────
  // Recalculated server-side at each renewal; never trusted from client
  baseAmount    Int @default(0) // Base plan price in INR
  extraUsers    Int @default(0) // Extra seats beyond included base
  extraUserRate Int @default(0) // Per-extra-user rate in INR
  totalAmount   Int @default(0) // Total charged per cycle in INR

  // ── Billing period (ANCHOR preserved on renewal) ──────────────────────────
  // On successful renewal: newPeriodStart = previousPeriodEnd (NOT now)
  // This prevents billing-date drift across cycles.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // ── Cancellation state ────────────────────────────────────────────────────
  cancelledAt  DateTime?
  cancelReason String?

  // ── Failure / grace period tracking ──────────────────────────────────────
  failureCount      Int       @default(0)
  lastFailureReason String?
  graceUntil        DateTime? // Deadline before downgrade; null if not in PAST_DUE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId])
  @@index([hdfcMandateId])
  @@index([status])
  @@index([currentPeriodEnd]) // Renewal scheduler: WHERE currentPeriodEnd < now + 26h
}

/// Immutable payment ledger — one row per HDFC transaction.
model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  type           PaymentType
  status         PaymentStatus @default(PENDING)

  // ── HDFC transaction identifiers ─────────────────────────────────────────
  // hdfcOrderId: our generated unique order ID (max 21 chars, alphanumeric)
  // hdfcTxnId:   HDFC's internal txn ID from Order Status response
  hdfcOrderId String  @unique // Idempotency key — checked before processing
  hdfcTxnId   String? // Set once HDFC confirms the transaction

  // ── Amount snapshot at time of execution ─────────────────────────────────
  amount        Int // Charged amount in INR
  currency      String @default("INR")
  seatsAtCharge Int // Snapshot of active org member count at execution time

  // ── Failure details ───────────────────────────────────────────────────────
  failureCode   String?
  failureReason String?

  // ── Refund details ────────────────────────────────────────────────────────
  refundedAmount  Int?
  refundRequestId String? // unique_request_id sent to HDFC Refund API (max 21 chars)

  processedAt DateTime? // When HDFC status was confirmed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([hdfcOrderId]) // Return URL + webhook idempotency lookups
  @@index([status])
  @@index([type])
}
