generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum SecretType {
  PASSWORD
  API_KEY
  TOKEN
  SSH_KEY
  CERTIFICATE
  OAUTH
  COOKIE
  TEXT
  JSON
  OTHER
}

enum SecretStatus {
  ACTIVE
  DISABLED
  PENDING_ROTATION
  DELETED
}

enum KeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  fullName               String    @default("")
  passwordHash           String
  emailVerifiedAt        DateTime?
  emailVerificationToken String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  refreshTokens           RefreshToken[]
  organizationMemberships OrganizationMember[]
  grantedSessions         DelegatedSession[]    @relation("SessionGrantor")
  receivedSessions        DelegatedSession[]    @relation("SessionGrantee")
  approvalRequests        ApprovalRequest[]
  auditEvents             AuditEvent[]
  passwordResetTokens     PasswordResetToken[]
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  isRevoked         Boolean   @default(false)
  expiresAt         DateTime
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?
  deviceInfo        Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([userId])
  @@index([familyId])
  // Composite: used by token validation (find active token for user)
  @@index([userId, isRevoked])
  // Composite: used by logout + password-reset (revoke all non-revoked tokens)
  @@index([userId, isRevoked, expiresAt])
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  settings  Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  members              OrganizationMember[]
  invitations          OrganizationInvitation[]
  vaults               Vault[]
  delegatedSessions    DelegatedSession[]
  approvalRequests     ApprovalRequest[]
  auditEvents          AuditEvent[]
  integrationConnections IntegrationConnection[]
  apiKeys              ApiKey[]
  webhookSubscriptions WebhookSubscription[]
}

model OrganizationMember {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  joinedAt       DateTime       @default(now())
  removedAt      DateTime?
  invitedBy      String?
  lastActiveAt   DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([tokenHash])
}

model KeyMetadata {
  id        String    @id @default(uuid())
  version   Int       @unique
  algorithm String    @default("AES-256-GCM")
  status    KeyStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  secrets              Secret[]
  secretVersions       SecretVersion[]
  integrationConnections IntegrationConnection[]
}

model Vault {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  defaultTTL     Int? // Future: Default session TTL in seconds
  rotationPolicy Json? // Future: Auto-rotation configuration
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  secrets      Secret[]

  @@index([organizationId])
}

model Secret {
  id            String       @id @default(uuid())
  vaultId       String
  name          String
  description   String?
  type          SecretType   @default(OTHER)
  status        SecretStatus @default(ACTIVE)
  encryptedDek  String // DEK encrypted by MEK
  keyMetadataId String // References KeyMetadata.id

  lastRevealedAt DateTime?
  revealCount    Int       @default(0)
  lastRotatedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  vault       Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata     @relation(fields: [keyMetadataId], references: [id])
  versions    SecretVersion[]

  @@unique([vaultId, name])
  @@index([vaultId])
}

model SecretVersion {
  id            String  @id @default(uuid())
  secretId      String
  version       Int
  ciphertext    String
  iv            String
  authTag       String
  fingerprint   String // SHA-256 of plaintext
  algorithm     String  @default("AES-256-GCM")
  keyMetadataId String
  aadHash       String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  createdBy String?

  secret      Secret      @relation(fields: [secretId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata @relation(fields: [keyMetadataId], references: [id])

  @@unique([secretId, version])
  @@index([secretId])
}

enum SessionStatus {
  PENDING_GRANT   // Integration-bound: DB row written, grantAccess() not yet confirmed
  ACTIVE
  REVOKE_FAILED   // revokeAccess() failed; scheduler will retry
  REVOKED
  EXPIRED
}


enum SessionScope {
  VAULT
  SECRET
}

enum SessionPermission {
  REVEAL
}

model DelegatedSession {
  id             String @id @default(uuid())
  organizationId String
  grantorId      String // User who created the session
  granteeId      String // Internal User who can use the session

  scope      SessionScope
  resourceId String // ID of the Vault or Secret based on scope
  permission SessionPermission @default(REVEAL)

  status      SessionStatus @default(ACTIVE)
  expiresAt   DateTime
  maxReveals  Int? // Optional limit on reveals
  revealCount Int           @default(0)

  // ─── Integration binding ─────────────────────────────────────────────────
  // Populated when a native provider integration is used (e.g. Vercel, GitHub).
  // Gives the revocation worker all context it needs — no guessing.
  integrationProvider            String? // e.g. "VERCEL" | "GITHUB"
  integrationResourceType        String? // e.g. "TEAM" | "ORGANIZATION" | "REPOSITORY"
  integrationResourceExternalId  String? // e.g. teamId, orgLogin, "owner/repo"
  integrationReferenceId         String? // Provider-issued ID returned by grantAccess (uid, username, etc.)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
  revokedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantor      User         @relation("SessionGrantor", fields: [grantorId], references: [id])
  grantee      User         @relation("SessionGrantee", fields: [granteeId], references: [id])

  @@index([organizationId])
  @@index([granteeId])
  @@index([status])
  @@index([resourceId])
  // Composite: used by expiry scheduler and session dashboard queries
  @@index([organizationId, status])
  // Composite: used by getIncomingSessions with status filter
  @@index([granteeId, status])
  // Composite: used by getOutgoingSessions
  @@index([grantorId, organizationId])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  DELEGATED_SESSION
}

model ApprovalRequest {
  id             String @id @default(uuid())
  organizationId String
  requesterId    String

  type           ApprovalType @default(DELEGATED_SESSION)
  requestPayload Json

  status ApprovalRequestStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?
  reason     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation(fields: [requesterId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model AuditEvent {
  id             String  @id @default(uuid())
  organizationId String
  actorId        String? // The user who performed the action

  action       String // e.g., "secret.revealed", "session.created"
  resourceType String? // e.g., "SECRET", "DELEGATED_SESSION", "APPROVAL_REQUEST"
  resourceId   String? // e.g., secretId, sessionId, approvalId

  eventVersion Int   @default(1)
  metadata     Json? // Serialized event data (e.g., reason for reveal)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@index([resourceType, resourceId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Release D: Integrations ────────────────────────────────────────────────

enum IntegrationProvider {
  VERCEL
  GITHUB
  GODADDY
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

/// One row per (organization, provider) connection.
/// The PAT/token is encrypted with the org's MEK before storage.
model IntegrationConnection {
  id             String              @id @default(uuid())
  organizationId String
  provider       IntegrationProvider
  status         IntegrationStatus   @default(ACTIVE)

  /// Encrypted PAT — AES-256-GCM envelope, same scheme as secrets.
  encryptedToken  String
  encryptedDek    String
  keyMetadataId   String

  /// Provider-specific metadata (team ID, org slug, account ID, etc.)
  providerMeta Json?

  /// Last time a health-check was performed against the provider API.
  lastCheckedAt DateTime?
  /// Human-readable error message from the last health-check failure.
  lastError     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyMetadata  KeyMetadata  @relation(fields: [keyMetadataId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
}

// ─── Release D: API Keys ─────────────────────────────────────────────────────

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

/// API Keys issued to external integrations / CI pipelines.
/// The actual key is shown once on creation; only a SHA-256 hash is stored.
model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String       // Human-readable label
  keyHash        String       @unique // SHA-256 of the raw key
  keyPrefix      String       // First 8 chars for display (e.g. "sdap_abc1")
  status         ApiKeyStatus @default(ACTIVE)
  expiresAt      DateTime?
  lastUsedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  createdBy String?
  revokedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@index([organizationId, status])
}

model WebhookSubscription {
  id             String    @id @default(cuid())
  organizationId String
  url            String
  events         String[]
  secret         String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
