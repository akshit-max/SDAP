generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum SecretType {
  PASSWORD
  API_KEY
  TOKEN
  SSH_KEY
  CERTIFICATE
  OAUTH
  COOKIE
  TEXT
  JSON
  OTHER
}

enum SecretStatus {
  ACTIVE
  DISABLED
  PENDING_ROTATION
  DELETED
}

enum KeyStatus {
  ACTIVE
  ROTATED
  REVOKED
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  fullName               String    @default("")
  passwordHash           String
  emailVerifiedAt        DateTime?
  emailVerificationToken String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  refreshTokens           RefreshToken[]
  organizationMemberships OrganizationMember[]
  grantedSessions         DelegatedSession[]   @relation("SessionGrantor")
  receivedSessions        DelegatedSession[]   @relation("SessionGrantee")
  approvalRequests        ApprovalRequest[]
  auditEvents             AuditEvent[]
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  isRevoked         Boolean   @default(false)
  expiresAt         DateTime
  lastUsedAt        DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?
  deviceInfo        Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  @@index([userId])
  @@index([familyId])
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  settings  Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  vaults            Vault[]
  delegatedSessions DelegatedSession[]
  approvalRequests  ApprovalRequest[]
  auditEvents       AuditEvent[]
}

model OrganizationMember {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  role           MembershipRole @default(OWNER)
  joinedAt       DateTime       @default(now())
  removedAt      DateTime?
  invitedBy      String?
  lastActiveAt   DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  tokenHash      String           @unique
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  invitedBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([tokenHash])
}

model KeyMetadata {
  id        String    @id @default(uuid())
  version   Int       @unique
  algorithm String    @default("AES-256-GCM")
  status    KeyStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  secrets        Secret[]
  secretVersions SecretVersion[]
}

model Vault {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  defaultTTL     Int? // Future: Default session TTL in seconds
  rotationPolicy Json? // Future: Auto-rotation configuration
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  secrets      Secret[]

  @@index([organizationId])
}

model Secret {
  id            String       @id @default(uuid())
  vaultId       String
  name          String
  description   String?
  type          SecretType   @default(OTHER)
  status        SecretStatus @default(ACTIVE)
  encryptedDek  String // DEK encrypted by MEK
  keyMetadataId String // References KeyMetadata.id

  lastRevealedAt DateTime?
  revealCount    Int       @default(0)
  lastRotatedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  vault       Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata     @relation(fields: [keyMetadataId], references: [id])
  versions    SecretVersion[]

  @@unique([vaultId, name])
  @@index([vaultId])
}

model SecretVersion {
  id            String  @id @default(uuid())
  secretId      String
  version       Int
  ciphertext    String
  iv            String
  authTag       String
  fingerprint   String // SHA-256 of plaintext
  algorithm     String  @default("AES-256-GCM")
  keyMetadataId String
  aadHash       String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  createdBy String?

  secret      Secret      @relation(fields: [secretId], references: [id], onDelete: Cascade)
  keyMetadata KeyMetadata @relation(fields: [keyMetadataId], references: [id])

  @@unique([secretId, version])
  @@index([secretId])
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionScope {
  VAULT
  SECRET
}

enum SessionPermission {
  REVEAL
}

model DelegatedSession {
  id             String @id @default(uuid())
  organizationId String
  grantorId      String // User who created the session
  granteeId      String // Internal User who can use the session

  scope      SessionScope
  resourceId String // ID of the Vault or Secret based on scope
  permission SessionPermission @default(REVEAL)

  status      SessionStatus @default(ACTIVE)
  expiresAt   DateTime
  maxReveals  Int? // Optional limit on reveals
  revealCount Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
  revokedBy String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantor      User         @relation("SessionGrantor", fields: [grantorId], references: [id])
  grantee      User         @relation("SessionGrantee", fields: [granteeId], references: [id])

  @@index([organizationId])
  @@index([granteeId])
  @@index([status])
  @@index([resourceId])
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  DELEGATED_SESSION
}

model ApprovalRequest {
  id             String @id @default(uuid())
  organizationId String
  requesterId    String

  type           ApprovalType @default(DELEGATED_SESSION)
  requestPayload Json

  status ApprovalRequestStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?
  reason     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation(fields: [requesterId], references: [id])

  @@index([organizationId])
  @@index([status])
}

model AuditEvent {
  id             String  @id @default(uuid())
  organizationId String
  actorId        String? // The user who performed the action

  action       String // e.g., "secret.revealed", "session.created"
  resourceType String? // e.g., "SECRET", "DELEGATED_SESSION", "APPROVAL_REQUEST"
  resourceId   String? // e.g., secretId, sessionId, approvalId

  eventVersion Int   @default(1)
  metadata     Json? // Serialized event data (e.g., reason for reveal)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@index([resourceType, resourceId])
}
