{
  "manifest_version": 3,
  "name": "WithUs Vault",
  "version": "1.0.0",
  "description": "Securely autofill delegated credentials for supported platforms through WithUs.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "privacy"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "https://*.godaddy.com/*",
    "https://*.hostinger.com/*",
    "https://*.cpanel.net/*",
    "https://*.cpanelhosting.net/*",
    "https://*.siteground.com/*",
    "https://*.vercel.com/*",
    "https://*.github.com/*",
    "https://*.stripe.com/*",
    "https://*.razorpay.com/*",
    "https://*.shopify.com/*",
    "https://*.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.godaddy.com/*",
        "https://*.hostinger.com/*",
        "https://*.cpanel.net/*",
        "https://*.cpanelhosting.net/*",
        "https://*.siteground.com/*",
        "https://*.github.com/*",
        "https://*.vercel.com/*",
        "https://*.stripe.com/*",
        "https://*.razorpay.com/*",
        "https://*.shopify.com/*",
        "https://*.linkedin.com/*"
      ],
      "exclude_matches": [
        "https://dashboard.razorpay.com/*",
        "https://app.razorpay.com/*",
        "https://app.vercel.com/*",
        "https://dashboard.stripe.com/dashboard",
        "https://app.shopify.com/*"
      ],
      "js": ["content/autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WithUs Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
