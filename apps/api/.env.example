# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/sdap_db?sslmode=disable"

# ---------------------------------------------------------
# SECURITY & SECRETS
# ---------------------------------------------------------
# Required: The master key for the vault. Must be a 32-byte string (often Base64 encoded).
# Generate via: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
VAULT_ENCRYPTION_KEY="<REPLACE_WITH_32_BYTE_BASE64_KEY>"

# Optional but Recommended: JWT Keys.
# If these are not provided, the system will attempt to read from keys/private.pem and keys/public.pem.
JWT_PRIVATE_KEY="<REPLACE_WITH_RSA_PRIVATE_KEY_IF_NOT_USING_PEM_FILES>"
JWT_PUBLIC_KEY="<REPLACE_WITH_RSA_PUBLIC_KEY_IF_NOT_USING_PEM_FILES>"

# ---------------------------------------------------------
# SERVER & NETWORK
# ---------------------------------------------------------
PORT=4000
NODE_ENV="production"
CORS_ORIGIN="https://your-production-frontend-domain.com"

# ---------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
