# -----------------------------------------------------------------------------
# Secure Delegated Access Platform (SDAP)
# Production Environment Configuration Template (.env.production.example)
#
# IMPORTANT: Never commit actual production credentials.
# Copy this file to `.env.production` (or your CI/CD secrets manager)
# -----------------------------------------------------------------------------

# --- Server Configuration ---
NODE_ENV=production
PORT=4000

# --- Database (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<db-host>:<port>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@prod-db-host.com:5432/withus-prod?sslmode=require"



# --- Security & JWT ---
# Keys used by the JwtStrategy. In production, these should be mounted to the container 
# via Vault/Secrets Manager or provided via environment variables.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Vault Cryptography ---
# 32-byte Base64 string for the Master Encryption Key (MEK) used in the Vault.
VAULT_ENCRYPTION_KEY="c3VwZXJzZWNyZXRrZXliYXNlNjRtdXN0YmUzMmJ5dGVz"

# --- SMTP Configuration ---
# Required in production for notifications and password resets
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
